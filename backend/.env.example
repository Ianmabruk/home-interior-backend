NODE_ENV=development
PORT=5000
CLIENT_URL=https://hokinteriors.co.ke
BASE_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require&channel_binding=require

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT Authentication
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Optional: File Storage (Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Redis (recommended for production with multiple instances)
# REDIS_URL=redis://user:password@host:port

# Server Identification (useful for load balancer tracing)
# SERVER_ID=hok-api-01

# Admin Seeding
# ADMIN_EMAIL / ADMIN_PASSWORD are the preferred variable names.
# SEED_ADMIN_* are accepted as legacy aliases.
# IMPORTANT: use a password of at least 12 characters. Quotes are recommended
# if the value contains special shell characters like #, $, or !.
# Do NOT ship the default insecure password (`admin123`) in production.
ADMIN_EMAIL=info@hokinteriors.co.ke
ADMIN_PASSWORD="change-me-to-a-strong-12+char-password"
SEED_ADMIN_EMAIL=info@hokinteriors.co.ke
# SEED_ADMIN_PASSWORD="change-me-to-a-strong-12+char-password"

# Support email (receives newsletter subscription notifications)
SUPPORT_EMAIL=info@hokinteriors.co.ke

# Email delivery
# Primary: HostPinnacle SMTP (set SMTP_PASSWORD in the production environment — NEVER commit it).
SMTP_HOST=mail.hokinteriors.co.ke
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@hokinteriors.co.ke
SMTP_FROM=HOK Interiors <info@hokinteriors.co.ke>
# SMTP_PASSWORD — set ONLY in the production environment (cPanel Node.js App env vars).
# Do NOT add it here. Do NOT commit it to Git. Do NOT expose it to the frontend.

# Brevo transactional email integration (preferred)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=hello@hokinteriors.co.ke
BREVO_SENDER_NAME=HOK Interiors
# Optional fallback if Brevo is not configured:
# SMTP_PASSWORD=your-smtp-password

# Login-notification email toggle (set to "false" to disable login notification emails)
# LOGIN_NOTIFICATION_ENABLED=true
